{
  "name": "p2p-config-sync-backend",
  "version": "1.0.0",
  "description": "P2P JSON Config Sync Backend with libp2p and CRDT",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
