    "@libp2p/mdns": "^8.0.0",
    "@libp2p/mplex": "^8.0.0",
    "@libp2p/tcp": "^7.0.0",
    "@libp2p/websockets": "^7.0.0",
    "@libp2p/peer-id": "^3.0.0",
    "@libp2p/peer-id-factory": "^3.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "it-length-prefixed": "^9.0.4",
    "it-pipe": "^3.0.1",
    "libp2p": "^0.45.0",
    "uint8arrays": "^5.0.1",
